    {
      "name": "glance",
      "version": "0.1.0",
      "manifest_path": "mods/glance/.claude-plugin/plugin.json",
      "path": "mods/glance",
      "author": {
        "name": "Hamza Zafar",
        "url": "https://github.com/hamzafer"
      },
      "description": "One line above the prompt with what needs you: next meeting, PRs, Linear issues and Slack DMs. /glance lists them all."
    },
    {
      "name": "md-preview",
      "version": "0.1.1",
      "manifest_path": "mods/md-preview/.claude-plugin/plugin.json",
      "path": "mods/md-preview",
      "author": {
        "name": "Hamza Zafar",
        "url": "https://github.com/hamzafer"
      },
      "description": "Shows the Markdown files Claude edits, rendered like GitHub, in a pane next to the chat. Before and after side by side. /md opens it."
    },
    {
      "name": "merge-gate",
      "version": "0.1.4",
      "manifest_path": "mods/merge-gate/.claude-plugin/plugin.json",
