  "mods": [
    {
      "name": "cache-timer",
      "version": "0.1.0",
      "manifest_path": "cache-timer/.claude-plugin/plugin.json",
      "path": "cache-timer",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Counts down to when the prompt cache expires, so you can send the next message before the whole conversation has to be cached again"
    },
    {
      "name": "change-ledger",
      "version": "0.1.2",
      "manifest_path": "change-ledger/.claude-plugin/plugin.json",
      "path": "change-ledger",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Lists the files this session edited in a pane (/changes), with line counts and who edited them, beside the git working tree"
    },
    {
      "name": "ci-watch",
      "version": "0.1.3",
      "manifest_path": "ci-watch/.claude-plugin/plugin.json",
      "path": "ci-watch",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Watches GitHub Actions in a band above the prompt after Claude pushes, opens a PR or pushes a tag: a progress bar per run, then pass or fail; optionally flags failed scheduled workflows at start"
    },
    {
      "name": "compact-keeper",
      "version": "0.1.1",
      "manifest_path": "compact-keeper/.claude-plugin/plugin.json",
      "path": "compact-keeper",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Saves each compaction's summary, with the files edited before it, to ~/.claude/handoffs so the context before /compact can be recovered"
    },
    {
      "name": "guardrails",
      "version": "0.3.1",
      "manifest_path": "guardrails/.claude-plugin/plugin.json",
      "path": "guardrails",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Blocks Cloudflare write commands, attribution lines in commits and PRs, and claude/ branch names"
    },
    {
      "name": "image-peek",
      "version": "0.1.3",
      "manifest_path": "image-peek/.claude-plugin/plugin.json",
      "path": "image-peek",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Shows the images you paste: thumbnails above the prompt, and larger pictures under each sent message in the chat; needs a kitty-graphics terminal such as Ghostty"
    },
    {
      "name": "loop-guard",
      "version": "0.1.0",
      "manifest_path": "loop-guard/.claude-plugin/plugin.json",
      "path": "loop-guard",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Tells the model, out of the user's sight, to stop when the same call fails twice with the same error"
    },
    {
      "name": "pin-board",
      "version": "0.1.1",
      "manifest_path": "pin-board/.claude-plugin/plugin.json",
      "path": "pin-board",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Pins standing notes with /pin that Claude keeps following after /compact and /clear; shows them in one row above the prompt or as a counter, and keeps them per folder with --keep"
    },
    {
      "name": "search-meter",
      "version": "0.1.0",
      "manifest_path": "search-meter/.claude-plugin/plugin.json",
      "path": "search-meter",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Counts the model's searches and colors each one: green found first try, yellow found after misses, red found nothing"
    },
    {
      "name": "secret-guard",
      "version": "0.1.2",
      "manifest_path": "secret-guard/.claude-plugin/plugin.json",
      "path": "secret-guard",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Keeps secrets out of the conversation: hides API keys and private keys before the model or the transcript sees them, and blocks reads of credential files and commands that print secrets"
    },
    {
      "name": "session-meter",
      "version": "0.3.0",
      "manifest_path": "session-meter/.claude-plugin/plugin.json",
      "path": "session-meter",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Shows a live session pane (/ctx): context breakdown, usage limits with pace, tool calls and model requests; sends the model a one-time note when limits or context cross a threshold"
    },
    {
      "name": "show-me",
      "version": "0.4.4",
      "manifest_path": "show-me/.claude-plugin/plugin.json",
      "path": "show-me",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Draws the mermaid diagrams of each answer as images in a pane (/show-me); needs mmdc and a kitty-graphics terminal such as Ghostty"
    },
    {
      "name": "turn-footer",
      "version": "0.1.0",
      "manifest_path": "turn-footer/.claude-plugin/plugin.json",
      "path": "turn-footer",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Turns the line under each answer into a turn summary (tools, requests, tokens, cache hit) and shows the running tool in the spinner"
    },
    {
      "name": "turn-timeline",
      "version": "0.1.3",
      "manifest_path": "turn-timeline/.claude-plugin/plugin.json",
      "path": "turn-timeline",
      "author": {
        "name": "Mehmet Aras",
        "url": "https://github.com/arasovic"
      },
      "description": "Draws the current turn as a timeline in a pane (/timeline): model requests and tool calls per loop, where the time went, and the slowest steps"
    }
  ],
