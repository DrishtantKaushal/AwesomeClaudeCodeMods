  "mods": [
    {
      "name": "cache-keeper",
      "version": "1.0.0",
      "manifest_path": "cache-keeper/.claude-plugin/plugin.json",
      "path": "cache-keeper",
      "author": {
        "name": "Nate Herk"
      },
      "description": "Keeps a big chat's prompt cache warm, warns before an expensive cold restart, shows every local chat on one board (/board), and hands a chat off to a fresh one (/handoff)"
    },
    {
      "name": "collision-guard",
      "version": "1.0.0",
      "manifest_path": "collision-guard/.claude-plugin/plugin.json",
      "path": "collision-guard",
      "author": {
        "name": "Nate Herk"
      },
      "description": "Asks before Claude edits a file another open chat changed in the last 30 minutes: Proceed, Move to a worktree, or Cancel (/guard)"
    },
    {
      "name": "goal-meter",
      "version": "1.0.0",
      "manifest_path": "goal-meter/.claude-plugin/plugin.json",
      "path": "goal-meter",
      "author": {
        "name": "Nate Herk"
      },
      "description": "A progress bar for /goal built from Claude's own task plan: tasks done out of the plan, elapsed time, an ETA at the goal's own pace, and every chat's goal in /goals"
    },
    {
      "name": "recording-mode",
      "version": "1.0.0",
      "manifest_path": "recording-mode/.claude-plugin/plugin.json",
      "path": "recording-mode",
      "author": {
        "name": "Nate Herk"
      },
      "description": "/rec before you record: masks keys, personal details, and business figures on screen and keeps private files closed (/rec strict, /rec off, /rec config)"
    }
  ],
